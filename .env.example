# X106 API — Environment Variables
# Copy this to .env and fill in values.

# Django
DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-me-with-a-real-secret
ALLOWED_HOSTS=localhost,127.0.0.1,api.kynguyen.cc

# Database (kept compatible with the legacy Go env names)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=x106
DB_USER=root
DB_PASSWORD=

# Auth
JWT_SECRET=change-this-to-a-strong-random-string
COOKIE_DOMAIN=localhost
# Production: COOKIE_DOMAIN=.kynguyen.cc

# Celery / Redis
REDIS_URL=redis://127.0.0.1:6379/0

# DeepSeek (LLM)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
LLM_DAILY_LIMIT=5

# Gunicorn (used by systemd ExecStart)
GUNICORN_BIND=127.0.0.1:4000
