[Unit]
Description=X106 Celery beat (scheduled stale-job recovery + cleanup)
After=network.target mysql.service redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/api
EnvironmentFile=/etc/x106-api.env
Environment=DJANGO_SETTINGS_MODULE=x106.settings.production
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/var/www/api/.venv/bin/celery -A x106 beat -l info \
    --schedule=/var/lib/x106/celerybeat-schedule
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
